APP_ENV=development

LLM_PROVIDER=groq

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT=120

GROQ_API_KEY=YOUR_REAL_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=recruitment_resumes
CHUNK_SIZE=800
CHUNK_OVERLAP=150

RESUMES_DIR=./data/resumes
JOB_DESCRIPTIONS_DIR=./data/job_descriptions
CALENDAR_DATA_FILE=./data/mock_calendar.json

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

ENHANCEMENT_GATEKEEPER_ENABLED=true
ENHANCEMENT_AUDIT_LOG_DIR=./logs/audit
AUDIT_LOG_PATH=./logs/audit/audit_trail.jsonl
AUDIT_MAX_BYTES=10485760
AUDIT_BACKUP_COUNT=5
ENHANCEMENT_STRUCTURED_MEMORY_DIR=./data/memory
LOG_LEVEL=INFO

MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
MAX_DOCUMENT_CHUNKS=100
MAX_QUERY_LENGTH=1000
LLM_TIMEOUT_SECONDS=60